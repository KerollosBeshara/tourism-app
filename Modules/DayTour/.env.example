# DayTour Module Configuration

# Queue Configuration (for image processing jobs)
QUEUE_CONNECTION=redis
QUEUE_DRIVER=redis

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_CACHE_DB=1

# Job Retry Configuration
QUEUE_TRIES=3
QUEUE_TIMEOUT=300

# AWS S3 Configuration (for image storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-s3-bucket-name
AWS_URL=https://your-s3-bucket-name.s3.amazonaws.com
AWS_ENDPOINT=

# Image Processing Configuration
DAYTOUR_IMAGE_MAX_SIZE=10485760
DAYTOUR_IMAGE_DISK=s3
DAYTOUR_CACHE_TTL=3600

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug
